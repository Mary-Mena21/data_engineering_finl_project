    select unnest(works) as work 
    from "warehouse"."main"."bronze_openlibrary_books"
)
select
    work.key as work_key,
    work.title,
    work.first_publish_year,
    -- authors is a list of structs inside each work
    work.authors[1]['name'] as author_name,
    work.edition_count
from raw
  );

